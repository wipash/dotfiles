{{- if and (lookPath "herdr") (.is_desktop) -}}
#!/usr/bin/env fish

echo "Installing/updating herdr plugins: {{ .herdr_plugins | join " " }}"
{{ range .herdr_plugins -}}
  echo Installing herdr plugin '{{ . }}'
  herdr plugin install {{ . }}
{{ end }}
if herdr server reload-config 2>/dev/null
  echo "Reloaded herdr server config"
else
  echo "herdr server not running; skipping config reload"
end

{{ end -}}
