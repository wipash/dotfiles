#!/usr/bin/env bash

# Add new update commands here; each entry runs independently.
updates=(
  "omp update"
  "claude update"
  "codex update"
  "no-mistakes update"
  "uv tool upgrade --all"
  "volta install npm@latest"
  "npm update -g"
  "brew update && brew upgrade -y"
)

# Only run with -f/--full.
full_updates=(
{{- $distros := printf "%s %s" (.chezmoi.osRelease.id | default "") (.chezmoi.osRelease.idLike | default "") | splitList " " }}
{{- if or (has "debian" $distros) (has "ubuntu" $distros) }}
  "sudo apt-get update && sudo apt-get upgrade -y"
{{- end }}
)

full=0
for arg in "$@"; do
  case "$arg" in
    -f | --full) full=1 ;;
    *)
      echo "usage: upd [-f|--full]" >&2
      exit 1
      ;;
  esac
done

if ((full)); then
  updates=("${full_updates[@]}" "${updates[@]}")
fi

failed=()
for cmd in "${updates[@]}"; do
  printf '\n==> %s\n' "$cmd"
  if [[ "$cmd" == "codex update" ]]; then
    installed_version=$(codex --version | awk '{print $2}')
    latest_version=$(npm view @openai/codex version 2>/dev/null || true)
    if [[ -n "$latest_version" && "$installed_version" == "$latest_version" ]]; then
      printf 'Codex CLI %s is up to date\n' "$installed_version"
      continue
    fi
  fi
  if ! eval "$cmd"; then
    printf '!!! failed: %s\n' "$cmd" >&2
    failed+=("$cmd")
  fi
done

if ((${#failed[@]})); then
  printf '\n%d update(s) failed:\n' "${#failed[@]}" >&2
  printf '  - %s\n' "${failed[@]}" >&2
  exit 1
fi
